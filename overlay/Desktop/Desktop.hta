<!DOCTYPE html>
<html>
<head>
<!-- PE 里 docMode>=9 的 mshta 页面拿不到输入框焦点(focus() 与真鼠标点击都无效, 实测见
     test\pe10_focusprobe.ps1); docMode 7/8 完全正常, 所以这里固定 IE=8 并只用 IE8 认的 CSS。 -->
<!-- i18n(v11): 全部界面文案集中在 script 区的 I18N 表(zh/en 两套, 键必须一一对应, 由
     build\scratch\t_hta_i18n_gate.js 校验键完整性)。带 k 属性的静态节点由 applyLang() 统一
     填 innerHTML; 动态文案一律走 T('KEY')。开机按 Nls\Language(退回 WMI Locale) 自动判定,
     顶栏 English/中文 按钮手动切换。PE 注册表不持久化: 重启后回到自动判定, 这是刻意设计。 -->
<meta http-equiv="x-ua-compatible" content="IE=8" />
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>WinPE 救援桌面</title>
<HTA:APPLICATION
  ID="WinPEDesktop"
  APPLICATIONNAME="WinPE Rescue Desktop"
  BORDER="none"
  INNERBORDER="no"
  MAXIMIZEBUTTON="yes"
  MINIMIZEBUTTON="yes"
  SCROLL="no"
  SINGLEINSTANCE="yes"
  CONTEXTMENU="no"
/>
<style>
  /* IE8 文档模式不支持 rgba()/linear-gradient/box-shadow/border-radius/background-size/
     四边同时定位。每条现代写法前面都放一条 IE8 能解析的纯色兜底(IE8 会丢弃它读不懂的那条)。
     跨全屏的层(bar/grid/foot/frp)不用 right/bottom 拉伸, 宽度由 layout() 按视口算成 px。 */
  html,body { height:100%; margin:0; padding:0; overflow:hidden;
    font-family:"Microsoft YaHei","Segoe UI","SimHei",sans-serif; }
  body { background-color:#0b1424; color:#e8f1ff;
    background-image:url('wallpaper.jpg');
    background-repeat:no-repeat; background-position:center center;
    background-size:cover; }
  /* IE8 没有 background-size:cover, 用老滤镜把壁纸拉到整屏(edge/IE9+ 会忽略这条, 走 body 的 cover) */
  #bg { -ms-filter:"progid:DXImageTransform.Microsoft.AlphaImageLoader(src='wallpaper.jpg', sizingMethod='scale')";
        filter:progid:DXImageTransform.Microsoft.AlphaImageLoader(src='wallpaper.jpg', sizingMethod='scale');
        position:absolute; top:0; left:0; z-index:1; }

  /* ---------- 顶栏 ---------- */
  #bar { position:absolute; top:0; left:0; height:66px; z-index:5;
    background:#0e1a2b; background:rgba(8,16,30,0.58);
    border-bottom:1px solid #24405f; border-bottom:1px solid rgba(120,180,255,0.22); }
  #bar .l { float:left; padding:14px 0 0 20px; }
  #bar .r { float:right; padding:6px 20px 0 0; text-align:right; }
  #brand { display:inline-block; width:34px; height:34px; line-height:34px; margin-right:12px;
    text-align:center; font-size:15px; font-weight:bold; color:#fff; border-radius:9px;
    background:#2b7fd4; background:linear-gradient(135deg,#2b7fd4,#1e5f8f);
    box-shadow:0 2px 8px rgba(0,0,0,.45); }
  #title { display:inline-block; font-size:19px; font-weight:bold; letter-spacing:1px;
    vertical-align:12px; }
  #sub { display:inline-block; font-size:12px; color:#9dc4ee; vertical-align:14px; margin-left:10px; }
  #clock { font-size:20px; font-weight:bold; color:#dff0ff; }
  #host { font-size:12px; color:#9dc4ee; margin-top:2px; }

  /* ---------- 图标区 ---------- */
  #grid { position:absolute; top:66px; left:0; z-index:5; overflow:auto; }
  #gridwrap { display:block; padding:22px 26px; }
  .tile { display:inline-block; vertical-align:top; width:120px; margin:8px 10px 14px 10px;
    padding:12px 6px 10px 6px; text-align:center; cursor:pointer; border-radius:14px;
    background:#141f33; background:rgba(255,255,255,0.06);
    border:1px solid #2a4160; border:1px solid rgba(150,200,255,0.16);
    box-shadow:0 3px 12px rgba(0,0,0,0.28); }
  .tile:hover { background:#24405f; background:rgba(120,180,255,0.18);
    border-color:#52759b; border-color:rgba(170,215,255,0.5); }
  .badge { width:54px; height:54px; line-height:54px; margin:0 auto; border-radius:14px;
    font-size:18px; font-weight:bold; color:#fff; letter-spacing:0; }
  .name { font-size:13px; margin-top:9px; color:#eaf3ff; }
  .hint { font-size:11px; margin-top:3px; color:#8fb6dd; }
  .c1 { background:#2668a1; background:linear-gradient(135deg,#2f80c3,#1c4f7a); }
  .c2 { background:#2c8857; background:linear-gradient(135deg,#3aa76d,#1f6b47); }
  .c3 { background:#6a52a6; background:linear-gradient(135deg,#8a6fc7,#4b3a86); }
  .c4 { background:#a06b28; background:linear-gradient(135deg,#c7883a,#8a5320); }
  .c5 { background:#a03a52; background:linear-gradient(135deg,#c25566,#7e2f42); }
  .c6 { background:#2f7b89; background:linear-gradient(135deg,#3d9aa8,#215b68); }
  .grp { display:block; width:100%; margin:14px 0 2px 4px; font-size:12px; color:#9cc6ef;
    letter-spacing:2px; padding-bottom:4px;
    border-bottom:1px solid #233c58; border-bottom:1px solid rgba(130,185,240,0.18); }

  /* ---------- 底栏状态 ---------- */
  #foot { position:absolute; bottom:0; left:0; height:118px; z-index:5;
    background:#0e1a2b; background:rgba(8,16,30,0.66);
    border-top:1px solid #24405f; border-top:1px solid rgba(120,180,255,0.22); }
  #footrow { padding:8px 20px 0 20px; }
  .pill { display:inline-block; margin:4px 10px 4px 0; padding:5px 12px 5px 10px;
    font-size:12.5px; border-radius:20px;
    background:#182438; background:rgba(255,255,255,0.08);
    border:1px solid #2f4a68; border:1px solid rgba(150,200,255,0.2); }
  .dot { display:inline-block; width:9px; height:9px; border-radius:50%; margin-right:7px;
    vertical-align:1px; background:#777; }
  .ok { background:#39d98a; box-shadow:0 0 8px #39d98a; }
  .bad { background:#ff6b6b; }
  .idle { background:#8aa0b8; }
  #ipbox { cursor:pointer; }
  #note { font-size:11.5px; color:#8fb2d6; line-height:1.6; margin:2px 0 0 0; padding:0 20px; }
  .btn { font-size:13px; padding:6px 16px; margin:0 6px 0 0; cursor:pointer; color:#eaf4ff;
    background:#30609a; background:linear-gradient(180deg,#3b6da8,#264f7d);
    border:1px solid #6f9bd1; border-radius:7px; }
  .btn:hover { background:#3f74b3; background:linear-gradient(180deg,#4a82c4,#2f5f94); }
  .btn.mini { font-size:12px; padding:4px 12px; }
  .btn.gray { background:#3b4453; background:linear-gradient(180deg,#4a5768,#333d4a); border-color:#76839a; }

  /* ---------- frp 面板 ---------- */
  #frp { display:none; position:absolute; top:66px; right:0; width:420px; z-index:9;
    overflow:auto; background:#070e1a; background:rgba(7,14,26,0.94);
    border-left:1px solid #2b4c73; border-left:1px solid rgba(130,190,255,0.3); }
  #frpin { display:block; padding:16px 18px; }
  #frp h3 { margin:0 0 10px 0; font-size:16px; }
  #frp label { display:block; font-size:12px; color:#9dc4ee; margin:11px 0 3px 0; }
  /* IE8 没有 box-sizing: 宽度按 content-box 算死(384 内容 - 16 内边距 - 2 边框) */
  #frp input, #frp select { width:366px; padding:6px 8px; font-size:13px;
    color:#eaf4ff; background:#14243c; border:1px solid #3d6390; border-radius:5px; }
  #frp .row { margin-top:14px; }
  #frplog { margin-top:12px; padding:8px; height:150px; overflow:auto; font-family:Consolas,monospace;
    font-size:11.5px; line-height:1.5; color:#c8dcf0; background:#0a1322;
    border:1px solid #29435f; border-radius:5px; white-space:pre; }
  #frpstat { font-size:12.5px; margin-top:10px; color:#9dc4ee; }
  .close { float:right; cursor:pointer; font-size:18px; color:#9dc4ee; padding:0 6px; }
  .close:hover { color:#fff; }

  /* ---------- WiFi 面板(照 #frp 那套 IE8 能解析的写法) ---------- */
  #wlan { display:none; position:absolute; top:66px; right:0; width:420px; z-index:9;
    overflow:auto; background:#070e1a; background:rgba(7,14,26,0.94);
    border-left:1px solid #2b4c73; border-left:1px solid rgba(130,190,255,0.3); }
  #wlanin { display:block; padding:16px 18px; }
  #wlan h3 { margin:0 0 10px 0; font-size:16px; }
  #wlan label { display:block; font-size:12px; color:#9dc4ee; margin:11px 0 3px 0; }
  #wlan .tip { display:block; font-size:12px; color:#9dc4ee; line-height:1.6; margin:0 0 6px 0; }
  #wlan input, #wlan select { width:366px; padding:6px 8px; font-size:13px;
    color:#eaf4ff; background:#14243c; border:1px solid #3d6390; border-radius:5px; }
  #wlan .row { margin-top:14px; }
  #wstat { font-size:12.5px; margin-top:10px; color:#9dc4ee; }

  /* ---------- 隐藏后的药丸 ---------- */
  #pill { display:none; position:absolute; top:0; left:0; z-index:20; padding:14px 18px;
    font-size:14px; cursor:pointer; color:#fff;
    background:#143c69; background:rgba(20,60,105,0.92);
    border:1px solid #5d90c8; border-radius:0 0 14px 0; }
</style>
</head>
<body>

<div id="bg"></div>

<div id="bar">
  <div class="l">
    <span id="brand">PE</span><span id="title" k="title">WinPE 救援桌面</span><span id="sub" k="sub">SSH / 向日葵 已自启 · frp 手动启动 · 面板 v10-ie8</span>
  </div>
  <div class="r">
    <div><button class="btn mini gray" id="langbtn" onclick="toggleLang()">English</button></div>
    <div id="clock">--:--:--</div>
    <div id="host">读取中...</div>
  </div>
</div>

<div id="grid"><div id="gridwrap">
  <span class="grp" k="grpTerm">终端与磁盘</span>
  <div class="tile" onclick="run('cmd.exe')"><div class="badge c1">CMD</div><div class="name" k="tCmd">命令提示符</div></div>
  <div class="tile" onclick="runPS()"><div class="badge c3">PS</div><div class="name">PowerShell</div></div>
  <div class="tile" onclick="run('notepad.exe')"><div class="badge c6">TXT</div><div class="name" k="tTxt">记事本</div></div>
  <div class="tile" onclick="run('cmd.exe /k diskpart')"><div class="badge c4">DSK</div><div class="name">diskpart</div></div>
  <div class="tile" onclick="run('cmd.exe /k X:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoExit -NoProfile -Command Get-Volume')"><div class="badge c4">VOL</div><div class="name" k="tVol">分区/卷标</div></div>

  <span class="grp" k="grpRescue">救援修复(离线, 先体检)</span>
  <div class="tile" onclick="run('cmd.exe /k ' + PSEXEC + ' -NoProfile -ExecutionPolicy Bypass -File X:\\Windows\\System32\\bootfix.ps1 -Check')"><div class="badge c4">BCD</div><div class="name" k="tBoot">引导体检/修复</div><div class="hint" k="tBootHint">bootfix, 含 BOOTSTAT 收尾链</div></div>
  <div class="tile" onclick="run('cmd.exe /k ' + PSEXEC + ' -NoProfile -ExecutionPolicy Bypass -File X:\\Windows\\System32\\filefix.ps1 -Check')"><div class="badge c1">FIL</div><div class="name" k="tFile">系统文件体检</div><div class="hint" k="tFileHint">filefix: 离线 sfc, 约 1-4 分钟</div></div>
  <div class="tile" onclick="run('cmd.exe /k ' + PSEXEC + ' -NoProfile -ExecutionPolicy Bypass -File X:\\Windows\\System32\\drvfix.ps1')"><div class="badge c3">DRV</div><div class="name" k="tDrv">启动驱动体检</div><div class="hint" k="tDrvHint">drvfix: 列被禁用的启动关键服务</div></div>
  <div class="tile" onclick="run('cmd.exe /k ' + PSEXEC + ' -NoProfile -ExecutionPolicy Bypass -File X:\\Windows\\System32\\letterfix.ps1')"><div class="badge c2">LTR</div><div class="name" k="tLtr">盘符体检</div><div class="hint" k="tLtrHint">letterfix: 解 MountedDevices 对卷</div></div>
  <div class="tile" onclick="run('cmd.exe /k ' + PSEXEC + ' -NoProfile -ExecutionPolicy Bypass -File X:\\Windows\\System32\\gptfix.ps1')"><div class="badge c5">GPT</div><div class="name" k="tGpt">分区表体检/修复</div><div class="hint" k="tGptHint">gptfix: GPT 头/表, 支持盘外 dump 还原</div></div>

  <span class="grp" k="grpNet">网络与远程</span>
  <div class="tile" onclick="run('cmd.exe /k ipconfig /all')"><div class="badge c2">NET</div><div class="name" k="tNet">网络信息</div></div>
  <div class="tile" onclick="run('cmd.exe /k netstat -anop tcp')"><div class="badge c2">PORT</div><div class="name" k="tPort">端口状态</div></div>
  <div class="tile" onclick="run('cmd.exe /k type X:\\sshd.log')"><div class="badge c1">SSH</div><div class="name" k="tSsh">SSH 日志</div><div class="hint">pe-sshd :22</div></div>
  <div class="tile" onclick="runSunlogin()"><div class="badge c5">SOS</div><div class="name" k="tSos">向日葵 SOS</div><div class="hint" k="tSosHint">识别码在其窗口</div></div>
  <div class="tile" onclick="openFrp()"><div class="badge c5">FRP</div><div class="name" k="tFrp">frp 穿透</div><div class="hint" k="tFrpHint">手动配置并启动</div></div>
  <div class="tile" onclick="openWlan()"><div class="badge c6">WiFi</div><div class="name" k="tWlan">WiFi 连接</div><div class="hint" k="tWlanHint">扫描/连接, 绿灯=已连</div></div>

  <span class="grp" k="grpPower">日志与电源</span>
  <div class="tile" onclick="runReport()"><div class="badge c2">RPT</div><div class="name" k="tRpt">自检报告</div><div class="hint" k="tRptHint">网络/SSH/frp/向日葵, 结果写 U 盘</div></div>
  <div class="tile" onclick="run('notepad.exe X:\\boot.log')"><div class="badge c3">LOG</div><div class="name" k="tLog">启动日志</div></div>
  <div class="tile" onclick="doPower('shutdown')"><div class="badge c5">OFF</div><div class="name" k="tOff">关机</div></div>
  <div class="tile" onclick="doPower('reboot')"><div class="badge c4">RST</div><div class="name" k="tRst">重启</div></div>
</div></div>

<div id="frp"><div id="frpin">
  <span class="close" onclick="closeFrp()">×</span>
  <h3 k="frpTitle">frp 内网穿透（手动）</h3>
  <div style="font-size:12px;color:#9dc4ee;line-height:1.6" k="frpIntro">
    frpc 不随开机启动。填好下面几项 → 保存配置 → 启动，窗口里能直接看到连接日志。
  </div>

  <label k="frpLAddr">frp 服务器地址 serverAddr（例: frp.example.com 或 1.2.3.4）</label>
  <input id="addr" type="text" />
  <label k="frpLSport">服务器端口 serverPort</label>
  <input id="sport" type="text" value="7000" />
  <label k="frpLToken">鉴权令牌 auth.token（与 frps 一致，留空则不带）</label>
  <input id="token" type="text" />

  <label k="frpLSsh">穿透本机 SSH</label>
  <div style="font-size:12px;color:#9dc4ee;margin:2px 0 6px 0">
    <span k="frpSshA">本地 127.0.0.1:22 映射到服务器的</span>
    <input id="rport" type="text" value="6000" style="width:70px;display:inline-block;padding:3px 6px" />
    <span k="frpSshB">端口</span>
  </div>

  <div class="row">
    <button class="btn" onclick="saveFrp()" k="frpBtnSave">保存配置</button>
    <button class="btn" onclick="startFrp()" k="frpBtnStart">启动 frpc</button>
    <button class="btn gray" onclick="stopFrp()" k="frpBtnStop">停止</button>
  </div>
  <div class="row">
    <button class="btn mini gray" onclick="loadFrp()" k="frpBtnReload">重新读取配置</button>
    <button class="btn mini gray" onclick="tailFrp()" k="frpBtnTail">刷新日志</button>
    <button class="btn mini gray" onclick="run('notepad.exe X:\\frpc.log')" k="frpBtnNote">记事本打开日志</button>
    <button class="btn mini gray" onclick="run('cmd.exe /k type X:\\Desktop\\Frp\\frpc.toml')" k="frpBtnToml">查看 toml</button>
  </div>
  <div id="frpstat" k="frpStatLoading">状态读取中...</div>
  <div id="frplog" k="frpLogEmpty">(还没有日志)</div>
</div></div>

<!-- WiFi 面板: wifi.exe 已具备 scan/connect/disconnect/status, 这里只做 UI(约束与编码见脚本区 WiFi 段注释)。 -->
<div id="wlan"><div id="wlanin">
  <span class="close" onclick="closeWlan()">×</span>
  <h3 k="wlanTitle">WiFi 连接</h3>
  <div class="tip" k="wlanTip">扫描后点列表选一个网络(也可手输 SSID), 填密码点连接。连上后底部 WiFi 灯变绿并显示网络名。<br />
    开放网络密码留空; 连不上时对照列表里的加密类型(wpa2-psk 等)确认。</div>
  <label k="wlanLList">扫描到的网络(双击连接)</label>
  <select id="wlist" size="8" onchange="wPick()" ondblclick="wConnect()"></select>
  <label>SSID</label>
  <input id="wssid" type="text" />
  <label k="wlanLKey">密码 / 密钥(开放网络留空)</label>
  <input id="wkey" type="text" />
  <div class="row">
    <button class="btn" onclick="wScan()" id="wbtnscan" k="btnScan">扫描</button>
    <button class="btn" onclick="wConnect()" id="wbtnc" k="btnConn">连接</button>
    <button class="btn gray" onclick="wDisconnect()" k="btnDis">断开</button>
    <button class="btn gray" onclick="wSaveConf()" k="btnSaveConf">保存配置</button>
  </div>
  <div id="wstat" k="frpStatLoading">状态读取中...</div>
  <div id="wlog" k="wLogEmpty">(还没扫描)</div>
</div></div>

<div id="foot">
  <div id="footrow">
    <span class="pill"><span id="d-ssh" class="dot idle"></span><span k="pillSsh">SSH 服务端</span></span>
    <span class="pill"><span id="d-sun" class="dot idle"></span><span k="pillSun">向日葵</span></span>
    <span class="pill"><span id="d-frp" class="dot idle"></span><span>frpc</span></span>
    <span class="pill"><span id="d-wlan" class="dot idle"></span><span>WiFi</span></span>
    <span class="pill" id="ipbox" onclick="copySsh()"><span id="d-ip" class="dot idle"></span><span id="ip">IP 读取中</span></span>
    <span class="pill" id="d-tunnel">隧道: 未启用</span>
    <span style="float:right">
      <button class="btn mini" onclick="openFrp()" k="btnFrpPanel">frp 面板</button>
      <button class="btn mini gray" onclick="hideDesktop()" k="btnHide">隐藏桌面</button>
    </span>
  </div>
  <div id="note">
    <span id="noteTxt" k="noteHtml">SSH：<b>ssh Administrator@上面的IP</b>（救援盘默认空密码直接进，也认公钥 X:\SSH\authorized_keys；点 IP 可复制命令）。
    向日葵与 SSH 已开机自启；frpc 需在本面板手动启动。日志：X:\boot.log、X:\sshd.log、X:\frpc.log</span>
    <span id="copymsg" style="color:#7fe0ac"></span>
  </div>
</div>

<div id="pill" onclick="showDesktop()" k="pillRestore">恢复桌面</div>

<script>
var shell = new ActiveXObject("WScript.Shell");
var fso   = new ActiveXObject("Scripting.FileSystemObject");
var FRPDIR = "X:\\Desktop\\Frp";
var CFG    = FRPDIR + "\\frpc.toml";
var PSEXEC = "X:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe";

/* ---------------- i18n: 字符串表(zh/en 键必须一一对应, t_hta_i18n_gate.js 将完整性) ---------------- */
/* ==I18N-START== */
var I18N = {
  zh: {
    title: "WinPE 救援桌面",
    sub: "SSH / 向日葵 已自启 · frp 手动启动 · 面板 v11-i18n",
    grpTerm: "终端与磁盘", grpRescue: "救援修复(离线, 先体检)", grpNet: "网络与远程", grpPower: "日志与电源",
    tCmd: "命令提示符", tTxt: "记事本", tVol: "分区/卷标",
    tBoot: "引导体检/修复", tBootHint: "bootfix, 含 BOOTSTAT 收尾链",
    tFile: "系统文件体检", tFileHint: "filefix: 离线 sfc, 约 1-4 分钟",
    tDrv: "启动驱动体检", tDrvHint: "drvfix: 列被禁用的启动关键服务",
    tLtr: "盘符体检", tLtrHint: "letterfix: 解 MountedDevices 对卷",
    tGpt: "分区表体检/修复", tGptHint: "gptfix: GPT 头/表, 支持盘外 dump 还原",
    tNet: "网络信息", tPort: "端口状态", tSsh: "SSH 日志",
    tSos: "向日葵 SOS", tSosHint: "识别码在其窗口",
    tFrp: "frp 穿透", tFrpHint: "手动配置并启动",
